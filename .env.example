# 로컬 학습용 예시입니다. 값을 복사해 .env 로 저장하고, JWT_SECRET 과 MCP_TOKEN 은 직접 바꿉니다.
APP_ENV=development
HTTP_ADDR=:8080
DB_DRIVER=sqlite
DB_DSN=file:board.db?_pragma=busy_timeout(5000)
JWT_SECRET=dev-only-change-me-please-32b
JWT_TTL=168h
CORS_ORIGIN=http://localhost:5173
SEED=1
AI_PROVIDER=mock
AI_MODEL=mock
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434
AI_DAILY_TOKEN_LIMIT=200000
MCP_TOKEN=dev-mcp-token
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
RATE_LIMIT_PER_MIN=0
OAUTH_MOCK=1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/oauth/google/callback
WEB_DIR=
OPENAPI_PATH=
